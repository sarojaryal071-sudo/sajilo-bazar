# Leave unset for local dev - Vite proxies /api to http://localhost:4000
# (see vite.config.js). In production (Vercel), set this to the deployed
# API's origin with no trailing slash, e.g. https://sajilo-bazar-api.onrender.com
VITE_API_URL=

# Same OAuth 2.0 Client ID as apps/api's GOOGLE_CLIENT_ID (see that file's
# comment for how to create one - free Google Cloud tier). Used client-side
# by Google Identity Services to request an ID token; the backend verifies
# it. Leave unset to hide the "Continue with Google" button entirely
# (GoogleSignInButton.jsx renders nothing without it) rather than show a
# button that would fail.
VITE_GOOGLE_CLIENT_ID=
