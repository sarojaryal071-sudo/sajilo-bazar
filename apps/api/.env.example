PORT=4000
# Local dev: a plain localhost connection string, no SSL needed.
# Production (Neon): the "Pooled connection" string from the Neon dashboard,
# e.g. postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/sajilo_bazar?sslmode=require
# SSL is enabled automatically (see src/db/pool.js) for any non-localhost host.
DATABASE_URL=postgres://sajilo:sajilo_dev_pw@localhost:5432/sajilo_bazar
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# "Keep me logged in" issues a token with this expiry instead of the one
# above - see auth.service.js issueToken.
JWT_EXPIRES_IN_KEEP_LOGGED_IN=30d
# OAuth 2.0 Client ID from a Google Cloud project (APIs & Services >
# Credentials > Create Credentials > OAuth client ID > Web application).
# Free tier is sufficient. Must match VITE_GOOGLE_CLIENT_ID in apps/web -
# both are the same Client ID, one used server-side to verify ID tokens
# (google-auth-library), one used client-side to request them (Google
# Identity Services). "Continue with Google" returns
# 503 "Google sign-in is not configured" until this is set.
GOOGLE_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
WEB_ORIGIN=http://localhost:5173
